// Standard library for interacting with the Windows kernel IO.

use Strings

extern ptr GetStdHandle@4(i32 nStdHandle);
extern i32 WriteConsoleA@20(ptr hConsoleOutput, str lpBuffer, i32 nNumberOfCharsToWrite, i32[] lpNumberOfCharsWritten, ptr lpReserved);
extern i32 ReadConsoleA@20(ptr hConsoleInput, i8[] lpBuffer, i32 nNumberOfCharsToRead, i32[] lpNumberOfCharsRead, ptr pInputControl);
extern i32 SetConsoleTextAttribute@8(ptr hConsoleOutput, i32 wAttributes);
extern fn ExitProcess@4(i32 uExitCode);

ptr __GetStdoutHandle() {
        return GetStdHandle@4(-11);
}

ptr __GetStdinHandle() {
        return GetStdHandle@4(-10);
}

fn __SystemWrite(str text) {
        ptr stdoutHandle = __GetStdoutHandle();
        i32 length = String.Length(text);
        i32[] charsWritten = i32[1] {}; 
        
        WriteConsoleA@20(stdoutHandle, text, length, charsWritten, null);
}

fn __SetConsoleColor(i32 colorCode) {
        ptr stdoutHandle = __GetStdoutHandle();
        SetConsoleTextAttribute@8(stdoutHandle, colorCode);
}

