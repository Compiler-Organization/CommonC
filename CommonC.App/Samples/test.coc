use Console

struct Nested {
    str Name
}

struct Valid {
    Nested nested
}

class Person {
    str Name = "Fjodtolf"
    i32 Bla = 53
    Valid valid = Valid {
        nested: Nested {
            Name: "Jack"
        }
    }

    str EmitName() {
        printl("Joke")
        return this.Name
    }
}

fn main {
    Person person = Person {}

    printl(person.EmitName())

    printl(person.valid.nested.Name)
    printl(person.valid.nested.Name)
}