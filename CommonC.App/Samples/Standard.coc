use Console
use Files

fn Panic(str message) {
        __SetConsoleColor(12);
        __SystemWrite("PANIC: ");
        __SystemWrite(message);
        __SystemWrite("\n");
        __SetConsoleColor(7);

        // your statement compiler must automatically append an 'unreachable' token 
        // right after this call to safely seal the containing basic block!
        ExitProcess@4(1);
    }