// Library to generate random numbers

// i32 Random_Next()                           - Generates a random i32
// i32 Random_Next(i32 maxValue)               - Generates a random i32 between 0 and a ceiling
// i32 Random_Next(i32 minValue, i32 maxValue) - Generates a random i32 between a floor and a ceiling
// i32 Random_NextDouble()                     - Generates a random f64

extern i32 CryptAcquireContextA@20(ptr[] phProv, ptr pszContainer, ptr pszProvider, i32 dwProvType, i32 dwFlags);
extern i32 CryptGenRandom@12(ptr hProv, i32 dwLen, i8[] pbBuffer);
extern i32 CryptReleaseContext@8(ptr hProv, i32 dwFlags);

// Generates a random i32
i32 Random_Next() {
    i8[] buffer = i8[4] {}
    i32 result = 0
    
    __GenerateRandomBytes(buffer, 4)
    
    result = (buffer[0] & 255) | ((buffer[1] & 255) << 8) | ((buffer[2] & 255) << 16) | ((buffer[3] & 255) << 24)
    
    result = result & 2147483647
    return result
}

// Generates a random i32 between 0 and a ceiling
i32 Random_Next(i32 maxValue) {
    return Next() % maxValue
}

// Generates a random f64
f64 Random_NextDouble() {
    i8[] buffer = i8[8] {}
    __GenerateRandomBytes(buffer, 8)
    
    u64 lower = (buffer[0] & 255) | ((buffer[1] & 255) << 8) | ((buffer[2] & 255) << 16) | ((buffer[3] & 255) << 24)
    u64 upper = (buffer[4] & 255) | ((buffer[5] & 255) << 8) | ((buffer[6] & 255) << 16) | ((buffer[7] & 255) << 24)
    u64 randVal = lower | (upper << 32)
    
    u64 isolatedBits = randVal & 9007199254740991
    f64 divisor = 9007199254740992.0
    
    f64 finalValue = isolatedBits / divisor
    return finalValue
}

// Helper function to generate a set of random bytes
fn __GenerateRandomBytes(i8[] targetBuffer, i32 amount) {
    ptr[] providerHandleContainer = ptr[1] {}
    
    i32 PROV_RSA_FULL = 1
    i32 CRYPT_VERIFYCONTEXT = -268435456

    i32 acquireSuccess = CryptAcquireContextA@20(
        providerHandleContainer, 
        null, 
        null, 
        PROV_RSA_FULL, 
        CRYPT_VERIFYCONTEXT
    )

    if (acquireSuccess == 0) {
        return
    }

    ptr hProv = providerHandleContainer[0]

    i32 genSuccess = CryptGenRandom@12(hProv, amount, targetBuffer)
    if (genSuccess == 0) {
        // Will impliment failure handling soon.
    }

    CryptReleaseContext@8(hProv, 0)
}