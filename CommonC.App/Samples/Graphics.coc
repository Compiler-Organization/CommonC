// A graphics library using gdi32 (Graphics Device Interface) to create and draw graphics

use Strings
use Console
use GDIDataStructures

struct Window {
    str Title,
    str ClassName,
    i32 Width,
    i32 Height,

    ptr WindowHandle,
    ptr Device
}

fn CreateWindow(Window window) {
    ptr hInstance = GetModuleHandleA@4(null)
    ptr blackBrush = GetStockObject@4(4)

    WNDCLASSEXA wndClassPtr = WNDCLASSEXA {
        cbSize: 48,
        style: 3,
        lpfnWndProc: __WindowProc,
        cbClsExtra: 0,
        cbWndExtra: 0,
        hInstance: hInstance,
        hIcon: null,
        hCursor: null,
        hbrBackground: blackBrush,
        lpszMenuName: null,
        lpszClassName: window.ClassName,
        hIconSm: null
    }

    i16 classAtom = RegisterClassExA@4(wndClassPtr)
    
    i32 windowStyle = 268435456 + 13565952 // WS_VISIBLE | WS_OVERLAPPEDWINDOW

    ptr windowHandle = CreateWindowExA@48(
        0, 
        window.ClassName, 
        window.Title, 
        windowStyle, 
        100, 100, window.Width, window.Height, 
        null, null, hInstance, null
    )

    ShowWindow@8(windowHandle, 1)
    UpdateWindow@4(windowHandle)

    window.WindowHandle = windowHandle
    window.Device = GetDC@4(windowHandle)
}

fn ReleaseWindow(Window window) {
    DestroyWindow@4(window.WindowHandle)
    ReleaseDC@8(window.WindowHandle, window.Device)
}

bool WindowExists(Window window) {
    
    return IsWindow@4(window.WindowHandle) > 0
}