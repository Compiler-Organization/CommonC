use Console
use Strings
use GDIDataStructures



ptr WindowProc(ptr hWnd, i32 Msg, i32 wParam, i32 lParam) {
    if Msg == 16 {
        DestroyWindow@4(hWnd)
        return null
    }
    if Msg == 2 {
        return null
    }

    return DefWindowProcA@16(hWnd, Msg, wParam, lParam)
}

fn GenCircle {
    i32 screenWidth = 800
    i32 screenHeight = 600

    ptr hInstance = GetModuleHandleA@4(null)

    str className = "Circle window"
    str titleName = "Circle window"

    ptr blackBrush = GetStockObject@4(4)

    WNDCLASSEXA wndClassPtr = WNDCLASSEXA {
        cbSize: 48,
        style: 3,
        lpfnWndProc: WindowProc,
        cbClsExtra: 0,
        cbWndExtra: 0,
        hInstance: hInstance,
        hIcon: null,
        hCursor: null,
        hbrBackground: blackBrush,
        lpszMenuName: null,
        lpszClassName: className,
        hIconSm: null
    }

    i16 classAtom = RegisterClassExA@4(wndClassPtr)
    printl(Concat("Class Atom: ", ToString(classAtom)))
    
    i32 windowStyle = 268435456 + 13565952

    ptr windowHandle = CreateWindowExA@48(
        0, 
        className, 
        titleName, 
        windowStyle, 
        100, 100, screenWidth, screenHeight, 
        null, null, hInstance, null
    )

    printl(I32ToString(IsWindow@4(windowHandle)))

    ShowWindow@8(windowHandle, 1)
    UpdateWindow@4(windowHandle)

    ptr hdc = GetDC@4(windowHandle)

    MSG msg = MSG {}

    printl(I32ToString(IsWindow@4(windowHandle)))

    i32 UpDownModulation = 0
    i32 LeftRightModulation = 0
    i32 Step = 25

    while IsWindow@4(windowHandle) > 0 
    {
        
        i16 escState = GetAsyncKeyState@4(27)

        while PeekMessageA@20(msg, null, 0, 0, 1) > 0 {
            TranslateMessage@4(msg)
            DispatchMessageA@4(msg)

            i32 key = msg.wParam

            if(key == 40)
            {
                UpDownModulation = UpDownModulation + Step
            }

            if(key == 38)
            {
                UpDownModulation = UpDownModulation - Step
            }

            if(key == 39)
            {
                LeftRightModulation = LeftRightModulation + Step
            }

            if(key == 37)
            {
                LeftRightModulation = LeftRightModulation - Step
            }

        }

        if !(escState == 0) {
            DestroyWindow@4(windowHandle)
            break
        }

        Ellipse@20(hdc, 250 + LeftRightModulation, 150 + UpDownModulation, 550 + LeftRightModulation, 450 + UpDownModulation)
    }

    ReleaseDC@8(windowHandle, hdc)
    printl("Window closed cleanly. Program exit.")
}
