use Console
use Graphics

enum Test : i32 {
    value1,
    value2: 50,
    value3
}

fn GraphicsCircle {
    Window window = Window {
        Title: "Test",
        ClassName: "Test",
        Width: 500,
        Height: 500
    }

    CreateWindow(window)

    MSG msg = MSG {}

    i32 UpDownModulation = 0
    i32 LeftRightModulation = 0
    i32 Step = 25

    while WindowExists(window)
    {
        
        i16 escState = GetAsyncKeyState@4(27)

        while PeekMessageA@20(msg, null, 0, 0, 1) > 0 {
            TranslateMessage@4(msg)
            DispatchMessageA@4(msg)

            i32 key = msg.wParam

            if(key == 40)
            {
                UpDownModulation += Step
            }

            if(key == 38)
            {
                UpDownModulation -= Step
            }

            if(key == 39)
            {
                LeftRightModulation += Step
            }

            if(key == 37)
            {
                LeftRightModulation -= Step
            }

        }

        if !(escState == 0) {
            DestroyWindow@4(window.WindowHandle)
            break
        }

        Ellipse@20(window.Device, 250 + LeftRightModulation, 150 + UpDownModulation, 550 + LeftRightModulation, 450 + UpDownModulation)
    }

    ReleaseDC@8(window.WindowHandle, window.Device)
    printl("Window closed cleanly. Program exit.")
}